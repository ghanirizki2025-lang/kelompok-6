# GRAPH JARINGAN RUTE
# Disaster Response Logistic System
# ==========================================

from collections import deque


class Graph:
    def __init__(self):
        # adjacency list berbasis linked list sederhana
        self.graph = {}

    # tambah node/lokasi
    def tambah_node(self, lokasi):
        if lokasi not in self.graph:
            self.graph[lokasi] = []

    # tambah rute (graf tidak berarah)
    def tambah_rute(self, asal, tujuan, jarak):
        self.tambah_node(asal)
        self.tambah_node(tujuan)

        self.graph[asal].append((tujuan, jarak))
        self.graph[tujuan].append((asal, jarak))

    # menampilkan tetangga
    def tetangga(self, lokasi):
        if lokasi in self.graph:
            print(f"\nTetangga dari {lokasi}:")
            for tujuan, jarak in self.graph[lokasi]:
                print(f"-> {tujuan} ({jarak} km)")
        else:
            print("Lokasi tidak ditemukan")

    # BFS untuk cek lokasi terjangkau
    def bfs(self, start):
        visited = set()
        queue = deque()

        visited.add(start)
        queue.append(start)

        print("\nHasil BFS:")

        while queue:
            node = queue.popleft()
            print(node)

            for tetangga, jarak in self.graph[node]:
                if tetangga not in visited:
                    visited.add(tetangga)
                    queue.append(tetangga)

        return visited

    # deteksi lokasi tidak terjangkau
    def tidak_terjangkau(self, depot):
        visited = self.bfs(depot)

        print("\nLokasi Tidak Terjangkau:")

        tidak_ada = True

        for lokasi in self.graph:
            if lokasi not in visited:
                print(lokasi)
                tidak_ada = False

        if tidak_ada:
            print("Semua lokasi terjangkau")


# ==========================================
# PROGRAM UTAMA
# ==========================================

g = Graph()

# tambah rute
g.tambah_rute("Depot", "Desa A", 5)
g.tambah_rute("Depot", "Desa B", 7)
g.tambah_rute("Desa A", "Posko C", 4)
g.tambah_rute("Desa B", "Posko D", 6)

# node terpisah
g.tambah_node("Desa Terisolir")

# tampil adjacency list
print("=== GRAPH JARINGAN RUTE ===")

for lokasi in g.graph:
    print(f"\n{lokasi}")
    for tujuan, jarak in g.graph[lokasi]:
        print(f"-> {tujuan} ({jarak} km)")


# tampil tetangga
g.tetangga("Depot")

# BFS
g.bfs("Depot")

# cek lokasi tidak terjangkau
g.tidak_terjangkau("Depot")
